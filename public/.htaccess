# Hostinger — Next.js static export (output: "export", trailingSlash: true)
# Upload the entire contents of /out to public_html (include this hidden file).
Options -MultiViews -Indexes +FollowSymLinks
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Serve real files and folders (_next, images, haldi/, nikah/, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Trailing slash for exported app routes (refresh-safe directory URLs)
  RewriteRule ^(haldi|nikah|walima|mehndi)$ $1/ [R=301,L]

  # 3. Static invitation page (file at site root, not a route folder)
  RewriteRule ^invitation/?$ invitation.html [L]

  # 4. Custom 404 from Next export (trailingSlash → /404/index.html)
  ErrorDocument 404 /404/index.html
</IfModule>
