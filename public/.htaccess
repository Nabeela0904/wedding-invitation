# Next.js static export (output: "export", trailingSlash: true)
# Route folders: /haldi/, /nikah/, /walima/, /mehndi/ each contain index.html
Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files and directories unchanged (_next/, images, route folders, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Canonical trailing slash for exported app route directories
  RewriteRule ^(haldi|nikah|walima|mehndi)$ $1/ [R=301,L]

  # Static invitation page (single HTML file at site root)
  RewriteRule ^invitation/?$ invitation.html [L]

  ErrorDocument 404 /404/index.html
</IfModule>
