# Next.js static export (output: "export", trailingSlash: true)
# Routes export as folders: /haldi/index.html, /nikah/index.html, /walima/index.html
Options -Indexes +FollowSymLinks
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files as-is (_next/, images, styles.css, etc.)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Add trailing slash for app route directories
  RewriteRule ^(haldi|nikah|walima|mehndi)$ $1/ [R=301,L]

  # Home (envelope) and static invitation
  RewriteRule ^$ index.html [L]
  RewriteRule ^invitation/?$ invitation.html [L]

  # App routes → each folder's index.html
  RewriteRule ^(haldi|nikah|walima|mehndi)/$ $1/index.html [L]

  # Next.js 404 page
  RewriteRule ^404/$ 404/index.html [L]

  ErrorDocument 404 /404.html
</IfModule>
