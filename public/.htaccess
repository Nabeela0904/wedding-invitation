# Hostinger / Apache — Next.js static export (trailingSlash: true)
# Upload ALL contents of /out (or /hostinger-upload) into public_html.
DirectoryIndex index.html
Options -Indexes +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files as-is (_next/*, images, .css, .js, .html files, etc.)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Explicit routes (do not rely on directory listing — fixes Hostinger 404 on refresh)
  RewriteRule ^$ index.html [L]
  RewriteRule ^haldi/?$ haldi/index.html [L]
  RewriteRule ^nikah/?$ nikah/index.html [L]
  RewriteRule ^walima/?$ walima/index.html [L]
  RewriteRule ^mehndi/?$ mehndi/index.html [L]
  RewriteRule ^invitation/?$ invitation.html [L]
  RewriteRule ^404/?$ 404/index.html [L]

  ErrorDocument 404 /404.html
</IfModule>
