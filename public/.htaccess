RewriteEngine On
RewriteBase /

# Serve existing files and folders as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Event pages (Next.js static export)
RewriteRule ^haldi/?$ haldi.html [L]
RewriteRule ^nikah/?$ nikah.html [L]
RewriteRule ^walima/?$ walima.html [L]
RewriteRule ^mehndi/?$ mehndi.html [L]

# Main invitation page
RewriteRule ^invitation/?$ invitation.html [L]

# Envelope landing page
RewriteRule ^$ index.html [L]
